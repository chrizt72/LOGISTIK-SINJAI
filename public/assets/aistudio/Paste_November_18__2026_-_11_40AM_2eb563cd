import React, { useState, useEffect, useRef } from 'react';
import {
  Zap,
  Building2,
  Calendar,
  Send,
  Camera,
  CheckCircle2,
  AlertCircle,
  Clock,
  Trash2,
  Eye,
  FileSpreadsheet,
  ExternalLink,
  PenTool,
  Upload,
  PlusCircle,
  HelpCircle,
  FolderOpen,
  MapPin,
} from 'lucide-react';
import {
  Substation,
  TrafoData,
  TrafoManagementRecord,
  UserSession,
} from '../types/gardu';
import { SignaturePad } from './SignaturePad';
import {
  saveTrafoManagementRecord,
  getTrafoManagementRecords,
  syncTrafoRecordToServer,
  syncRecordToGoogleSpreadsheet,
  addWatermarkToImage,
  getUlpInfo,
  isSubstationMatchingUlp,
} from '../services/storageService';
import {
  subscribeGoogleAuthState,
  syncTrafoManagementToGoogleWorkspace,
  TrafoWorkspaceSyncResult,
  withTimeout,
} from '../services/googleWorkspaceService';
import {
  SISIP_TRAFO_EDIT_URL,
  SISIP_TRAFO_SHEET_GID,
  SISIP_TRAFO_SHEET_NAME,
  SISIP_TRAFO_ROOT_DRIVE_FOLDER_URL,
} from '../utils/spreadsheetSchema';
import {
  ManajemenTrafoSubmitPopup,
  TrafoSubmitPopupStage,
} from './ManajemenTrafoSubmitPopup';
import { PhotoRequirementModal } from './PhotoRequirementModal';

interface TrafoSisipFormProps {
  substations: Substation[];
  user: UserSession;
  isOnline?: boolean;
  onRecordSaved?: (record?: TrafoManagementRecord) => void;
  onNavigateToApproval?: () => void;
  onNavigateToHistory?: () => void;
}

const COMMON_TRAFO_BRANDS = [
  'Bambang Djaja (B&D)',
  'Trafindo (TRF)',
  'Sintra',
  'Voltra',
  'Schneider Electric',
  'Centrado',
  'Morita',
  'Starlite',
  'Asata',
];

const STANDARD_KVA_OPTIONS = [25, 50, 100, 160, 200, 250, 315, 400, 630];

const createInitialTrafoSisip = (): TrafoData => ({
  merk: '',
  daya: 0,
  kapasitasKva: 0,
  type: '',
  jenisMinyak: 'Mineral Oil (Dialan B)',
  nomorSeri: '',
  tahunBuat: new Date().getFullYear().toString(),
  impedansi: '4.0%',
  teganganPrimer: '20.000 V',
  teganganSekunder: '400 V / 231 V',
  arusPrimer: 0,
  arusSekunder: 0,
  volumeMinyak: '',
  beratTotal: 0,
  fasa: '3 Fasa',
  konstruksi: 'Portal',
  teganganNominal: '20 kV / 400 - 231 V',
  arusNominalA: 0,
  beratKg: 0,
});

export const TrafoSisipForm: React.FC<TrafoSisipFormProps> = ({
  substations,
  user,
  isOnline = true,
  onRecordSaved,
  onNavigateToApproval,
  onNavigateToHistory,
}) => {
  // Google Workspace Auth state
  const [isGoogleConnected, setIsGoogleConnected] = useState<boolean>(false);

  useEffect(() => {
    const unsub = subscribeGoogleAuthState((state) => {
      setIsGoogleConnected(state.isConnected);
    });
    return unsub;
  }, []);

  const ulpInfo = getUlpInfo(user.usid);
  const unitSubstations = substations.filter((g) => isSubstationMatchingUlp(g, user.usid));

  // Document details
  const [nomorLaporan, setNomorLaporan] = useState(
    `BA-TS/PLN-${user.usid}/${new Date().getFullYear()}/${Date.now().toString().slice(-4)}`
  );
  const [tanggal, setTanggal] = useState(new Date().toISOString().split('T')[0]);
  const [timestampWita, setTimestampWita] = useState('');

  // Identitas Gardu / Lokasi Tiang Sisip
  const [idGarduSisip, setIdGarduSisip] = useState('');
  const [namaGarduSisip, setNamaGarduSisip] = useState('');
  const [penyulang, setPenyulang] = useState('');
  const [lokasiAlamat, setLokasiAlamat] = useState('');
  const [selectedExistingGardu, setSelectedExistingGardu] = useState<Substation | null>(null);
  const [showGarduPicker, setShowGarduPicker] = useState(false);
  const [alasanSisip, setAlasanSisip] = useState('Perbaikan drop tegangan dan pembagian beban over-capacity');
  const [formValidationWarning, setFormValidationWarning] = useState<string | null>(null);

  // Koordinat GPS Gardu Sisip
  const [koordinatLat, setKoordinatLat] = useState<string>('-5.1264');
  const [koordinatLng, setKoordinatLng] = useState<string>('120.1518');
  const [isGettingGps, setIsGettingGps] = useState(false);
  const [gpsStatusMsg, setGpsStatusMsg] = useState<string | null>(null);

  const handleGetGpsCoordinates = () => {
    if (!navigator.geolocation) {
      alert('Fitur Geolocation tidak didukung pada browser ini.');
      return;
    }
    setIsGettingGps(true);
    setGpsStatusMsg(null);
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        const lat = pos.coords.latitude;
        const lng = pos.coords.longitude;
        const acc = Math.round(pos.coords.accuracy);
        setKoordinatLat(lat.toFixed(6));
        setKoordinatLng(lng.toFixed(6));
        setGpsStatusMsg(`✓ GPS Terdeteksi Akurat (±${acc}m)`);
        setIsGettingGps(false);
      },
      (err) => {
        console.warn('Geolocation error:', err);
        if (selectedExistingGardu) {
          setKoordinatLat(String(selectedExistingGardu.koordinatLat));
          setKoordinatLng(String(selectedExistingGardu.koordinatLng));
          setGpsStatusMsg('Menggunakan koordinat gardu referensi');
        } else {
          setGpsStatusMsg('Gagal mendeteksi GPS langsung');
        }
        setIsGettingGps(false);
      },
      { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
    );
  };

  // 13 Parameter Teknis Trafo Sisip (Hanya Trafo Baru Sisipan)
  const [trafoSisip, setTrafoSisip] = useState<TrafoData>(() => createInitialTrafoSisip());

  // 4 Photos Wajib Pemasangan Trafo Sisip:
  // 1. Nametag Trafo Sisip (disimpan pada fotoNameplateLamaUrl)
  // 2. Dudukan / Tiang Trafo Sisip (disimpan pada fotoNameplateBaruUrl)
  // 3. Foto Sebelum Pemasangan / Kondisi Awal Tiang (fotoSebelumUrl)
  // 4. Foto Sesudah Pemasangan / Bertegangan (fotoSesudahUrl)
  const [fotoNametagSisip, setFotoNametagSisip] = useState<string | null>(null);
  const [fotoTiangDudukan, setFotoTiangDudukan] = useState<string | null>(null);
  const [fotoSebelum, setFotoSebelum] = useState<string | null>(null);
  const [fotoSesudah, setFotoSesudah] = useState<string | null>(null);
  const [processingPhoto, setProcessingPhoto] = useState<string | null>(null);
  const [previewPhotoModal, setPreviewPhotoModal] = useState<string | null>(null);

  // Tanda Tangan: Pengawas Lapangan (kosong secara default agar bisa diisi manual oleh petugas)
  const [namaPengawas, setNamaPengawas] = useState('');
  const [nipPengawas, setNipPengawas] = useState('');
  const [sigPengawasUrl, setSigPengawasUrl] = useState<string>('');

  // Popup & Feedback
  const [isSubmitPopupOpen, setIsSubmitPopupOpen] = useState(false);
  const [isPhotoWarningModalOpen, setIsPhotoWarningModalOpen] = useState(false);
  const photoSectionRef = useRef<HTMLDivElement>(null);
  const [popupStage, setPopupStage] = useState<TrafoSubmitPopupStage>('confirm');
  const [draftTrafoRecord, setDraftTrafoRecord] = useState<TrafoManagementRecord | null>(null);
  const [popupProgressText, setPopupProgressText] = useState('');
  const [popupSyncResult, setPopupSyncResult] = useState<TrafoWorkspaceSyncResult | null>(null);
  const [popupErrorMessage, setPopupErrorMessage] = useState<string | null>(null);

  // Live WITA Clock
  useEffect(() => {
    const updateTime = () => {
      const now = new Date();
      const str =
        now.toLocaleDateString('id-ID', {
          day: '2-digit',
          month: '2-digit',
          year: 'numeric',
        }) +
        ' ' +
        now.toLocaleTimeString('id-ID', {
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
        }) +
        ' WITA';
      setTimestampWita(str);
    };
    updateTime();
    const interval = setInterval(updateTime, 1000);
    return () => clearInterval(interval);
  }, []);

  // Update auto calculation saat daya trafo sisip berubah
  const handleDayaChange = (kva: number) => {
    if (!kva || kva <= 0) {
      setTrafoSisip((prev) => ({
        ...prev,
        daya: 0,
        kapasitasKva: 0,
        arusPrimer: 0,
        arusSekunder: 0,
        arusNominalA: 0,
        volumeMinyak: '',
        beratTotal: 0,
        beratKg: 0,
      }));
      return;
    }

    const isSinglePhase = (trafoSisip.fasa || '').includes('1');
    const calcArusPrimer = isSinglePhase
      ? Math.round((kva / 20) * 100) / 100
      : Math.round((kva / (1.732 * 20)) * 100) / 100;
    const calcArusSekunder = isSinglePhase
      ? Math.round((kva / 0.231) * 10) / 10
      : Math.round((kva / (1.732 * 0.4)) * 10) / 10;
    const calcVol = Math.round(kva * 2.1);
    const calcBerat = Math.round(kva * 6.9);

    setTrafoSisip((prev) => ({
      ...prev,
      daya: kva,
      kapasitasKva: kva,
      arusPrimer: calcArusPrimer,
      arusSekunder: calcArusSekunder,
      arusNominalA: calcArusSekunder,
      volumeMinyak: calcVol,
      beratTotal: calcBerat,
      beratKg: calcBerat,
    }));
  };

  const handleSelectReferenceGardu = (gardu: Substation) => {
    setSelectedExistingGardu(gardu);
    setIdGarduSisip(`${gardu.id}-SISIP`);
    setNamaGarduSisip(`Gardu Sisip ${gardu.nama}`);
    setPenyulang(gardu.penyulang || '');
    setLokasiAlamat(gardu.alamat || `Dekat gardu ${gardu.nama}`);
    if (gardu.koordinatLat) setKoordinatLat(String(gardu.koordinatLat));
    if (gardu.koordinatLng) setKoordinatLng(String(gardu.koordinatLng));
    setGpsStatusMsg(null);
    setShowGarduPicker(false);
  };

  const handlePhotoUpload = async (
    e: React.ChangeEvent<HTMLInputElement>,
    type: 'nametag' | 'tiang' | 'sebelum' | 'sesudah'
  ) => {
    const file = e.target.files?.[0];
    if (!file) return;

    setProcessingPhoto(type);

    const reader = new FileReader();
    reader.onload = async (event) => {
      const rawDataUrl = event.target?.result as string;
      if (!rawDataUrl) {
        setProcessingPhoto(null);
        return;
      }

      const activeGps = {
        lat: parseFloat(koordinatLat) || selectedExistingGardu?.koordinatLat || -5.1264,
        lng: parseFloat(koordinatLng) || selectedExistingGardu?.koordinatLng || 120.1518,
      };

      const garduInfo = {
        id: idGarduSisip || 'GARDU-SISIP',
        nama: namaGarduSisip || `Gardu Sisip ${user.unit}`,
        ulp: user.unit,
      };

      const labels = {
        nametag: 'Foto Nametag Trafo Sisip',
        tiang: 'Foto Dudukan / Tiang Trafo Sisip',
        sebelum: 'Foto Sebelum Pekerjaan (Kondisi Awal Tiang)',
        sesudah: 'Foto Sesudah Pekerjaan (Bertegangan)',
      };

      try {
        const watermarked = await addWatermarkToImage(
          rawDataUrl,
          garduInfo,
          activeGps,
          labels[type],
          timestampWita || `${new Date().toLocaleDateString('id-ID')} WITA`,
          namaPengawas || 'Pengawas Lapangan'
        );

        if (type === 'nametag') setFotoNametagSisip(watermarked);
        else if (type === 'tiang') setFotoTiangDudukan(watermarked);
        else if (type === 'sebelum') setFotoSebelum(watermarked);
        else if (type === 'sesudah') setFotoSesudah(watermarked);
      } catch (err) {
        console.warn('Fallback raw image without watermark:', err);
        if (type === 'nametag') setFotoNametagSisip(rawDataUrl);
        else if (type === 'tiang') setFotoTiangDudukan(rawDataUrl);
        else if (type === 'sebelum') setFotoSebelum(rawDataUrl);
        else if (type === 'sesudah') setFotoSesudah(rawDataUrl);
      } finally {
        setProcessingPhoto(null);
      }
    };
    reader.readAsDataURL(file);
  };

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    setFormValidationWarning(null);

    const finalId = idGarduSisip.trim();
    const finalNama = namaGarduSisip.trim() || `Gardu Sisip ${finalId}`;

    if (!finalId) {
      setFormValidationWarning('Harap isi ID Gardu / Nama Tiang Sisipan Trafo.');
      window.scrollTo({ top: 100, behavior: 'smooth' });
      return;
    }

    // Validasi 4 Foto Dokumentasi Wajib
    if (!fotoNametagSisip || !fotoTiangDudukan || !fotoSebelum || !fotoSesudah) {
      setIsPhotoWarningModalOpen(true);
      return;
    }

    if (!sigPengawasUrl) {
      setFormValidationWarning('Tanda tangan Pengawas Pekerjaan wajib dibuat sebelum mengirim ke Supervisor.');
      return;
    }

    // Build Trafo Management Record untuk Sisip Trafo
    const draft: TrafoManagementRecord = {
      id: `TRF-SISIP-${Date.now()}`,
      nomorLaporan,
      tanggal,
      garduId: finalId,
      namaGardu: finalNama,
      ulp: user.unit || `ULP ${user.usid}`,
      usid: user.usid,
      penyulang: penyulang.trim() || selectedExistingGardu?.penyulang || 'Penyulang Distribusi',
      lokasi: lokasiAlamat.trim() || selectedExistingGardu?.alamat || `Lokasi Tiang ${finalId}`,
      koordinat: {
        lat: parseFloat(koordinatLat) || selectedExistingGardu?.koordinatLat || -5.1264,
        lng: parseFloat(koordinatLng) || selectedExistingGardu?.koordinatLng || 120.1518,
      },
      alasanPenggantian: alasanSisip.trim() || 'Pemasangan trafo sisip baru',
      jenisPekerjaan: 'SISIP',
      // Trafo Lama kosong/unit baru untuk sisipan
      trafoLama: {
        merk: '-',
        daya: 0,
        kapasitasKva: 0,
        type: '-',
        jenisMinyak: '-',
        nomorSeri: '-',
        tahunBuat: '-',
        impedansi: '-',
        teganganPrimer: '-',
        teganganSekunder: '-',
        arusPrimer: 0,
        arusSekunder: 0,
        volumeMinyak: '-',
        beratTotal: 0,
        fasa: '-',
        konstruksi: '-',
        teganganNominal: '-',
        arusNominalA: 0,
        beratKg: 0,
      },
      // 13 Parameter Trafo Baru (Sisipan)
      trafoBaru: {
        ...trafoSisip,
        kapasitasKva: Number(trafoSisip.daya || trafoSisip.kapasitasKva || 100),
      },
      // Bagan Tanda Tangan:
      namaPengawas: namaPengawas.trim() || 'Pengawas Pekerjaan Lapangan',
      nipPengawas: nipPengawas.trim() || '-',
      tandaTanganPengawasUrl: sigPengawasUrl,
      // Supervisor & Manager ULP diisi pada mode supervisor
      namaTlTeknik: '',
      nipTlTeknik: '',
      statusApproval: 'PENDING',
      namaManagerUlp: '',
      nipManagerUlp: '',
      // Foto Dokumentasi
      fotoNameplateLamaUrl: fotoNametagSisip || undefined, // Slot foto 1: Nametag Trafo Sisip
      fotoNameplateBaruUrl: fotoTiangDudukan || undefined, // Slot foto 2: Tiang/Dudukan Sisip
      fotoSebelumUrl: fotoSebelum || undefined, // Slot foto 3: Sebelum Pekerjaan
      fotoSesudahUrl: fotoSesudah || undefined, // Slot foto 4: Sesudah Pekerjaan
      createdAt: timestampWita || `${new Date().toLocaleDateString('id-ID')} WITA`,
      syncedToSpreadsheet: false,
      syncedToDrive: false,
      syncPending: !isOnline,
      isOfflineRecord: !isOnline,
    };

    setDraftTrafoRecord(draft);
    setPopupSyncResult(null);
    setPopupErrorMessage(null);
    setPopupProgressText('');
    setPopupStage('confirm');
    setIsSubmitPopupOpen(true);
  };

  const executeConfirmedSendToSupervisor = async () => {
    if (!draftTrafoRecord) return;

    setPopupStage('sending');
    setPopupErrorMessage(null);
    setPopupProgressText('Menyimpan & mengirim berkas Trafo Sisip ke Menu Akun Supervisor...');

    try {
      let finalRecord: TrafoManagementRecord = {
        ...draftTrafoRecord,
        statusApproval: 'PENDING',
        syncPending: !isOnline,
      };

      // Simpan ke storage lokal & server
      try {
        saveTrafoManagementRecord(finalRecord);
      } catch (err) {
        console.warn('saveTrafoManagementRecord fallback:', err);
      }

      if (isOnline) {
        await syncRecordToGoogleSpreadsheet(finalRecord, 'TRAFO_MGMT', isOnline);
      }

      // Jika online & Google Workspace terhubung, catat ke Sheet MANAJEMEN TRAFO
      if (isOnline && isGoogleConnected) {
        try {
          const wsResult = await withTimeout(
            syncTrafoManagementToGoogleWorkspace(finalRecord, {
              onStep: (msg) => setPopupProgressText(msg),
            }),
            20000,
            'Waktu upload mutasi trafo melebihi batas (Timeout 20 detik). Berkas tersimpan di antrean untuk disinkronkan ulang.'
          );
          finalRecord = wsResult.updatedRecord;
          saveTrafoManagementRecord(finalRecord);
          await syncRecordToGoogleSpreadsheet(finalRecord, 'TRAFO_MGMT', true);
          setPopupSyncResult(wsResult);
        } catch (err: any) {
          console.warn('Initial Google Sheet sync warning / timeout:', err);
          finalRecord.syncPending = true;
          saveTrafoManagementRecord(finalRecord);
        }
      }

      await syncTrafoRecordToServer(finalRecord);
      setDraftTrafoRecord(finalRecord);
      onRecordSaved?.(finalRecord);
      setPopupStage('success');
    } catch (err: any) {
      console.error('Error sending trafo sisip record to supervisor:', err);
      setPopupErrorMessage(
        err?.message || 'Terjadi kendala saat menyimpan berkas. Data tetap tersimpan di memori perangkat.'
      );
      setPopupStage('error');
    }
  };

  const handleResetForm = () => {
    setIsSubmitPopupOpen(false);
    setDraftTrafoRecord(null);
    setIdGarduSisip('');
    setNamaGarduSisip('');
    setPenyulang('');
    setLokasiAlamat('');
    setSelectedExistingGardu(null);
    setFotoNametagSisip(null);
    setFotoTiangDudukan(null);
    setFotoSebelum(null);
    setFotoSesudah(null);
    setNamaPengawas('');
    setNipPengawas('');
    setSigPengawasUrl('');
    setTrafoSisip(createInitialTrafoSisip());
    setNomorLaporan(
      `BA-TS/PLN-${user.usid}/${new Date().getFullYear()}/${Date.now().toString().slice(-4)}`
    );
  };

  return (
    <div className="space-y-4">
      {/* Banner Informasi Fitur Trafo Sisip */}
      <div className="bg-gradient-to-r from-purple-900 to-indigo-900 text-white rounded-2xl p-4 shadow-sm border border-purple-800">
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div className="space-y-1">
            <div className="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-purple-500/30 text-purple-200 text-[10px] font-black uppercase tracking-wider border border-purple-400/30">
              <PlusCircle className="w-3.5 h-3.5 text-amber-300" />
              <span>Form Sisip Trafo Baru</span>
            </div>
            <h3 className="text-base sm:text-lg font-black tracking-tight">
              Pemasangan Unit Trafo Sisip Distribusi {user.unit}
            </h3>
            <p className="text-xs text-purple-200/90 leading-relaxed max-w-xl">
              Menu khusus input pemasangan trafo sisipan baru ke jaringan (tanpa trafo lama). Dilengkapi 13 parameter teknis lengkap, 4 foto dokumentasi, dan diteruskan ke Supervisor untuk persetujuan Berita Acara.
            </p>
          </div>
          <div className="flex items-center gap-2 self-start sm:self-center">
            {onNavigateToHistory && (
              <button
                type="button"
                onClick={onNavigateToHistory}
                className="px-3 py-2 bg-white/10 hover:bg-white/20 text-white text-xs font-bold rounded-xl flex items-center gap-1.5 cursor-pointer transition-colors"
              >
                <span>Lihat Riwayat</span>
              </button>
            )}
            <a
              href={SISIP_TRAFO_EDIT_URL}
              target="_blank"
              rel="noopener noreferrer"
              className="px-3 py-2 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold rounded-xl flex items-center gap-1.5 shadow-sm"
            >
              <FileSpreadsheet className="w-3.5 h-3.5" />
              <span>Sheet Sisip (gid={SISIP_TRAFO_SHEET_GID})</span>
              <ExternalLink className="w-3 h-3" />
            </a>
            <a
              href={SISIP_TRAFO_ROOT_DRIVE_FOLDER_URL}
              target="_blank"
              rel="noopener noreferrer"
              className="px-3 py-2 bg-purple-600 hover:bg-purple-500 text-white text-xs font-bold rounded-xl flex items-center gap-1.5 shadow-sm"
            >
              <FolderOpen className="w-3.5 h-3.5" />
              <span>Drive Sisip</span>
              <ExternalLink className="w-3 h-3" />
            </a>
          </div>
        </div>
      </div>

      {formValidationWarning && (
        <div className="p-3 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 rounded-xl flex items-center gap-2 text-amber-800 dark:text-amber-200 text-xs">
          <AlertCircle className="w-4 h-4 shrink-0" />
          <span>{formValidationWarning}</span>
        </div>
      )}

      <form onSubmit={handleSubmit} className="space-y-4">
        {/* SECTION 1: LOKASI & IDENTITAS TIANG / GARDU SISIP */}
        <div className="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
          <div className="flex flex-wrap items-center justify-between gap-2">
            <label className="text-xs font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider flex items-center gap-1.5">
              <Building2 className="w-3.5 h-3.5 text-purple-600 dark:text-purple-400" />
              1. LOKASI &amp; IDENTITAS GARDU / TIANG SISIPAN
            </label>
            <span className="text-[10px] text-slate-500 font-mono">
              Unit: {user.unit}
            </span>
          </div>

          <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {/* Input ID Gardu / Tiang Sisip */}
            <div>
              <label className="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">
                ID Gardu / No. Tiang Sisip *
              </label>
              <input
                type="text"
                value={idGarduSisip}
                onChange={(e) => setIdGarduSisip(e.target.value.toUpperCase())}
                placeholder="Contoh: SI-08, G-TS01, atau T.144A"
                required
                className="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl font-bold font-mono focus:outline-none focus:ring-2 focus:ring-purple-500"
              />
            </div>

            {/* Nama Gardu Sisip */}
            <div>
              <label className="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">
                Nama Gardu Sisip *
              </label>
              <input
                type="text"
                value={namaGarduSisip}
                onChange={(e) => setNamaGarduSisip(e.target.value)}
                placeholder="Contoh: Gardu Sisip Bontoala, Trafo Sisip KP. Baru"
                required
                className="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl font-medium focus:outline-none focus:ring-2 focus:ring-purple-500"
              />
            </div>

            {/* Penyulang */}
            <div>
              <label className="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">
                Nama Penyulang Distribusi *
              </label>
              <input
                type="text"
                value={penyulang}
                onChange={(e) => setPenyulang(e.target.value)}
                placeholder="Contoh: Penyulang Kalumpang, Penyulang Kota"
                required
                className="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500"
              />
            </div>

            {/* Lokasi Alamat */}
            <div>
              <label className="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">
                Lokasi / Alamat Pemasangan
              </label>
              <input
                type="text"
                value={lokasiAlamat}
                onChange={(e) => setLokasiAlamat(e.target.value)}
                placeholder="Contoh: Jl. Poros Bontoala KM 3, Depan Masjid"
                className="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500"
              />
            </div>
          </div>

          {/* Opsi Cepat: Pilih dari Gardu Eksisting Terdekat */}
          <div className="pt-2 border-t border-slate-100 dark:border-slate-800">
            <button
              type="button"
              onClick={() => setShowGarduPicker(!showGarduPicker)}
              className="text-[11px] text-purple-700 dark:text-purple-300 font-bold hover:underline flex items-center gap-1 cursor-pointer"
            >
              <span>{showGarduPicker ? 'Sembunyikan Pilihan Gardu' : '+ Ambil Data dari Gardu Induk / Induk Terdekat'}</span>
            </button>

            {showGarduPicker && (
              <div className="mt-2 p-2.5 bg-purple-50/50 dark:bg-purple-950/20 border border-purple-200 dark:border-purple-800/50 rounded-xl space-y-2">
                <span className="text-[10px] text-slate-500 block font-medium">
                  Pilih gardu referensi untuk mengisi penyulang dan lokasi secara cepat:
                </span>
                <div className="max-h-40 overflow-y-auto space-y-1">
                  {unitSubstations.slice(0, 20).map((g) => (
                    <button
                      key={g.id}
                      type="button"
                      onClick={() => handleSelectReferenceGardu(g)}
                      className="w-full text-left p-2 rounded-lg bg-white dark:bg-slate-800 hover:bg-purple-100 dark:hover:bg-purple-900/40 text-xs flex items-center justify-between transition-colors cursor-pointer border border-slate-200 dark:border-slate-700"
                    >
                      <span className="font-bold">{g.id} - {g.nama}</span>
                      <span className="text-[10px] text-slate-500 font-mono">{g.penyulang}</span>
                    </button>
                  ))}
                </div>
              </div>
            )}
          </div>

          {/* Titik Koordinat GPS Lokasi Gardu Sisip */}
          <div className="p-3 bg-purple-50/70 dark:bg-purple-950/30 rounded-xl border border-purple-200 dark:border-purple-800 space-y-2">
            <div className="flex flex-wrap items-center justify-between gap-2">
              <span className="text-[11px] font-bold text-purple-900 dark:text-purple-300 flex items-center gap-1.5">
                <MapPin className="w-3.5 h-3.5 text-purple-600" />
                <span>Titik Koordinat Lokasi Gardu Sisip (GPS)</span>
              </span>
              <button
                type="button"
                onClick={handleGetGpsCoordinates}
                disabled={isGettingGps}
                className="px-2.5 py-1 text-[11px] font-bold bg-purple-600 hover:bg-purple-700 text-white rounded-lg flex items-center gap-1.5 shadow-sm transition-all cursor-pointer disabled:opacity-50"
              >
                <MapPin className={`w-3 h-3 ${isGettingGps ? 'animate-bounce' : ''}`} />
                <span>{isGettingGps ? 'Mengambil GPS...' : 'Ambil Titik Koordinat GPS'}</span>
              </button>
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">
              <div>
                <label className="block text-[10px] font-semibold text-slate-600 dark:text-slate-400 mb-0.5">
                  Latitude (X)
                </label>
                <input
                  type="number"
                  step="any"
                  value={koordinatLat}
                  onChange={(e) => setKoordinatLat(e.target.value)}
                  placeholder="-5.123456"
                  className="w-full px-2.5 py-1.5 text-xs bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg font-mono text-slate-800 dark:text-slate-200"
                />
              </div>
              <div>
                <label className="block text-[10px] font-semibold text-slate-600 dark:text-slate-400 mb-0.5">
                  Longitude (Y)
                </label>
                <input
                  type="number"
                  step="any"
                  value={koordinatLng}
                  onChange={(e) => setKoordinatLng(e.target.value)}
                  placeholder="120.123456"
                  className="w-full px-2.5 py-1.5 text-xs bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg font-mono text-slate-800 dark:text-slate-200"
                />
              </div>
            </div>

            {gpsStatusMsg && (
              <div className="text-[10px] font-medium text-emerald-700 dark:text-emerald-400 flex items-center gap-1">
                <span>{gpsStatusMsg}</span>
              </div>
            )}
          </div>

          {/* Alasan Penambahan Trafo Sisip */}
          <div className="pt-1">
            <label className="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">
              Alasan Penambahan Trafo Sisip *
            </label>
            <div className="flex flex-wrap gap-1.5 mb-2">
              {[
                'Perbaikan drop tegangan ujung jaringan',
                'Mengatasi overload trafo eksisting',
                'Penyambungan pelanggan baru masif',
                'Perbaikan kualitas tegangan pelayanan',
              ].map((alasan) => (
                <button
                  key={alasan}
                  type="button"
                  onClick={() => setAlasanSisip(alasan)}
                  className={`text-[10px] px-2.5 py-1 rounded-full font-medium transition-colors cursor-pointer border ${
                    alasanSisip === alasan
                      ? 'bg-purple-700 text-white border-purple-800 shadow-xs'
                      : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:bg-slate-200'
                  }`}
                >
                  {alasan}
                </button>
              ))}
            </div>
            <textarea
              rows={2}
              value={alasanSisip}
              onChange={(e) => setAlasanSisip(e.target.value)}
              required
              placeholder="Jelaskan alasan teknis pemasangan trafo sisip..."
              className="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500"
            />
          </div>
        </div>

        {/* SECTION 2: 13 PARAMETER TEKNIS TRAFO SISIP (HANYA BAGIAN TRAFO BARU) */}
        <div className="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
          <div className="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 dark:border-slate-800 pb-3">
            <div>
              <label className="text-xs font-bold text-purple-900 dark:text-purple-300 uppercase tracking-wider flex items-center gap-1.5">
                <Zap className="w-4 h-4 text-purple-600 dark:text-purple-400" />
                2. SPESIFIKASI DATA TEKNIS TRAFO SISIP (13 PARAMETER)
              </label>
              <p className="text-[11px] text-slate-500 mt-0.5">
                Hanya data trafo baru sisipan yang dimasukkan (tidak ada trafo lama yang dibongkar).
              </p>
            </div>
            <span className="text-[10px] font-black uppercase px-2.5 py-0.5 rounded-full bg-purple-100 text-purple-800 dark:bg-purple-950 dark:text-purple-300 border border-purple-300 dark:border-purple-800">
              Unit Baru Sisipan
            </span>
          </div>

          <div className="space-y-3.5">
            {/* 1. Merk Trafo */}
            <div>
              <label className="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">
                1. Merk Trafo Sisip *
              </label>
              <div className="flex flex-wrap gap-1.5 mb-2">
                {COMMON_TRAFO_BRANDS.map((brand) => (
                  <button
                    key={brand}
                    type="button"
                    onClick={() => setTrafoSisip({ ...trafoSisip, merk: brand })}
                    className={`text-[10px] px-2.5 py-1 rounded-full font-bold transition-all cursor-pointer border ${
                      trafoSisip.merk === brand
                        ? 'bg-purple-700 text-white border-purple-800 shadow-xs'
                        : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:bg-slate-200'
                    }`}
                  >
                    {brand}
                  </button>
                ))}
              </div>
              <input
                type="text"
                value={trafoSisip.merk || ''}
                onChange={(e) => setTrafoSisip({ ...trafoSisip, merk: e.target.value })}
                placeholder="Masukkan merk trafo sisip..."
                required
                className="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl font-bold focus:outline-none focus:ring-2 focus:ring-purple-500"
              />
            </div>

            {/* 2. Daya Trafo (kVA) */}
            <div>
              <label className="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">
                2. Daya Trafo Sisip (kVA) *
              </label>
              <div className="flex flex-wrap gap-1.5 mb-2">
                {STANDARD_KVA_OPTIONS.map((k) => (
                  <button
                    key={k}
                    type="button"
                    onClick={() => handleDayaChange(k)}
                    className={`text-xs px-3 py-1 rounded-xl font-black transition-all cursor-pointer border ${
                      Number(trafoSisip.daya || trafoSisip.kapasitasKva) === k
                        ? 'bg-purple-700 text-white border-purple-800 shadow-md scale-105'
                        : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:bg-slate-200'
                    }`}
                  >
                    {k} kVA
                  </button>
                ))}
              </div>
              <div className="relative">
                <input
                  type="number"
                  value={trafoSisip.daya ? trafoSisip.daya : ''}
                  onChange={(e) =>
                    handleDayaChange(e.target.value === '' ? 0 : parseFloat(e.target.value))
                  }
                  placeholder="Masukkan kVA (misal: 100)"
                  required
                  className="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl font-mono font-bold focus:outline-none focus:ring-2 focus:ring-purple-500"
                />
                <span className="absolute right-3 top-2 text-xs font-bold text-slate-400">
                  kVA
                </span>
              </div>
            </div>

            {/* 3. Type Trafo & 4. Jenis Minyak */}
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label className="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">
                  3. Type Trafo *
                </label>
                <input
                  type="text"
                  value={trafoSisip.type || trafoSisip.tipe || trafoSisip.konstruksi || ''}
                  onChange={(e) =>
                    setTrafoSisip({
                      ...trafoSisip,
                      type: e.target.value,
                      tipe: e.target.value,
                      konstruksi: e.target.value,
                    })
                  }
                  placeholder="Masukkan type trafo sisip (misal: Pasangan Luar)"
                  list="type-sisip-options"
                  required
                  className="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500"
                />
                <datalist id="type-sisip-options">
                  <option value="Pasangan Luar (Outdoor)" />
                  <option value="Pasangan Dalam (Indoor)" />
                  <option value="Hermetically Sealed (Kedap Udara)" />
                  <option value="Conservator Type" />
                  <option value="Dry Type (Cast Resin)" />
                </datalist>
              </div>

              <div>
                <label className="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">
                  4. Jenis Minyak *
                </label>
                <input
                  type="text"
                  value={trafoSisip.jenisMinyak || ''}
                  onChange={(e) => setTrafoSisip({ ...trafoSisip, jenisMinyak: e.target.value })}
                  placeholder="Mineral Oil (Dialan B), Ester Oil"
                  className="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500"
                />
              </div>
            </div>

            {/* 5. No Seri & 6. Tahun Buat */}
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label className="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">
                  5. No Seri Trafo *
                </label>
                <input
                  type="text"
                  value={trafoSisip.nomorSeri || ''}
                  onChange={(e) => setTrafoSisip({ ...trafoSisip, nomorSeri: e.target.value })}
                  placeholder="Contoh: BD-2026-9021"
                  required
                  className="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl font-mono focus:outline-none focus:ring-2 focus:ring-purple-500"
                />
              </div>

              <div>
                <label className="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">
                  6. Tahun Buat *
                </label>
                <input
                  type="text"
                  value={trafoSisip.tahunBuat || ''}
                  onChange={(e) => setTrafoSisip({ ...trafoSisip, tahunBuat: e.target.value })}
                  placeholder="Contoh: 2026"
                  required
                  className="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl font-mono focus:outline-none focus:ring-2 focus:ring-purple-500"
                />
              </div>
            </div>

            {/* 7. Impedansi & 12. Volume Minyak */}
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label className="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">
                  7. Impedansi (%) *
                </label>
                <input
                  type="text"
                  value={trafoSisip.impedansi || ''}
                  onChange={(e) => setTrafoSisip({ ...trafoSisip, impedansi: e.target.value })}
                  placeholder="Contoh: 4.0%"
                  className="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl font-mono focus:outline-none focus:ring-2 focus:ring-purple-500"
                />
              </div>

              <div>
                <label className="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">
                  12. Volume Minyak (L) *
                </label>
                <input
                  type="text"
                  value={trafoSisip.volumeMinyak || ''}
                  onChange={(e) => setTrafoSisip({ ...trafoSisip, volumeMinyak: e.target.value })}
                  placeholder="Contoh: 210 L"
                  className="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl font-mono focus:outline-none focus:ring-2 focus:ring-purple-500"
                />
              </div>
            </div>

            {/* 8. Tegangan Operasi Sisi Primer & 9. Tegangan Operasi Sisi Sekunder */}
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label className="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">
                  8. Tegangan Operasi Primer *
                </label>
                <input
                  type="text"
                  value={trafoSisip.teganganPrimer || trafoSisip.teganganNominal || ''}
                  onChange={(e) =>
                    setTrafoSisip({
                      ...trafoSisip,
                      teganganPrimer: e.target.value,
                      teganganNominal: e.target.value,
                    })
                  }
                  placeholder="20.000 V"
                  className="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500"
                />
              </div>

              <div>
                <label className="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">
                  9. Tegangan Operasi Sekunder *
                </label>
                <input
                  type="text"
                  value={trafoSisip.teganganSekunder || ''}
                  onChange={(e) => setTrafoSisip({ ...trafoSisip, teganganSekunder: e.target.value })}
                  placeholder="400 V / 231 V"
                  className="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500"
                />
              </div>
            </div>

            {/* 10. Arus Primer, 11. Arus Sekunder, & 13. Berat Total */}
            <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <div>
                <label className="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">
                  10. Arus Operasi Primer (A)
                </label>
                <input
                  type="number"
                  step="0.01"
                  value={trafoSisip.arusPrimer ?? ''}
                  onChange={(e) =>
                    setTrafoSisip({ ...trafoSisip, arusPrimer: parseFloat(e.target.value) || 0 })
                  }
                  placeholder="2.89 A"
                  className="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl font-mono focus:outline-none focus:ring-2 focus:ring-purple-500"
                />
              </div>

              <div>
                <label className="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">
                  11. Arus Operasi Sekunder (A)
                </label>
                <input
                  type="number"
                  step="0.1"
                  value={trafoSisip.arusSekunder ?? trafoSisip.arusNominalA ?? ''}
                  onChange={(e) => {
                    const val = parseFloat(e.target.value) || 0;
                    setTrafoSisip({ ...trafoSisip, arusSekunder: val, arusNominalA: val });
                  }}
                  placeholder="144.3 A"
                  className="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl font-mono focus:outline-none focus:ring-2 focus:ring-purple-500"
                />
              </div>

              <div>
                <label className="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">
                  13. Berat Total (kg)
                </label>
                <input
                  type="number"
                  value={trafoSisip.beratTotal ?? trafoSisip.beratKg ?? ''}
                  onChange={(e) => {
                    const val = parseFloat(e.target.value) || 0;
                    setTrafoSisip({ ...trafoSisip, beratTotal: val, beratKg: val });
                  }}
                  placeholder="690 kg"
                  className="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl font-mono focus:outline-none focus:ring-2 focus:ring-purple-500"
                />
              </div>
            </div>
          </div>
        </div>

        {/* SECTION 3: 4 FOTO DOKUMENTASI WAJIB */}
        <div
          ref={photoSectionRef}
          className="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-slate-200 dark:border-slate-800 shadow-sm space-y-3"
        >
          <div className="flex items-center justify-between">
            <label className="text-xs font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider flex items-center gap-1.5">
              <Camera className="w-3.5 h-3.5 text-purple-600 dark:text-purple-400" />
              3. UNGGAH 4 FOTO DOKUMENTASI PEMASANGAN TRAFO SISIP
            </label>
            <span className="text-[10px] font-black uppercase px-2 py-0.5 rounded-full bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300 border border-rose-300 dark:border-rose-800">
              4 Foto Wajib
            </span>
          </div>

          <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
            {/* Foto 1: Nametag Trafo Sisip */}
            <div className="border border-slate-200 dark:border-slate-700 rounded-2xl p-2.5 flex flex-col items-center justify-center text-center bg-slate-50/60 dark:bg-slate-850">
              <span className="text-[11px] font-bold text-slate-800 dark:text-slate-200 mb-1.5 line-clamp-1">
                Nametag Trafo Sisip
              </span>
              {fotoNametagSisip ? (
                <div className="relative w-full aspect-square rounded-xl overflow-hidden border border-slate-300 dark:border-slate-600">
                  <img src={fotoNametagSisip} alt="Nametag Trafo Sisip" className="w-full h-full object-cover" />
                  <div className="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 via-black/50 to-transparent p-1.5 flex items-center justify-center gap-1.5">
                    <button
                      type="button"
                      onClick={() => setPreviewPhotoModal(fotoNametagSisip)}
                      className="h-7 px-2 bg-white text-slate-900 rounded-lg text-[10px] font-bold flex items-center gap-1 shadow active:scale-95 cursor-pointer"
                    >
                      <Eye className="w-3 h-3" /> Lihat
                    </button>
                    <button
                      type="button"
                      onClick={() => setFotoNametagSisip(null)}
                      className="h-7 px-2 bg-rose-600 text-white rounded-lg text-[10px] font-bold flex items-center gap-1 shadow active:scale-95 cursor-pointer"
                    >
                      <Trash2 className="w-3 h-3" /> Ganti
                    </button>
                  </div>
                </div>
              ) : (
                <label className="w-full aspect-square min-h-[90px] border-2 border-dashed border-slate-300 dark:border-slate-700 rounded-xl flex flex-col items-center justify-center cursor-pointer hover:bg-purple-50 dark:hover:bg-slate-800 transition-colors p-1.5 text-center active:scale-[0.98]">
                  <Camera className="w-5 h-5 text-slate-400 mb-1" />
                  <span className="text-[10px] font-semibold text-purple-700 dark:text-purple-300 leading-tight">
                    {processingPhoto === 'nametag' ? 'Proses...' : '+ Nametag Sisip'}
                  </span>
                  <input
                    type="file"
                    accept="image/*"
                    capture="environment"
                    onChange={(e) => handlePhotoUpload(e, 'nametag')}
                    className="hidden"
                  />
                </label>
              )}
            </div>

            {/* Foto 2: Dudukan / Tiang Trafo Sisip */}
            <div className="border border-slate-200 dark:border-slate-700 rounded-2xl p-2.5 flex flex-col items-center justify-center text-center bg-slate-50/60 dark:bg-slate-850">
              <span className="text-[11px] font-bold text-slate-800 dark:text-slate-200 mb-1.5 line-clamp-1">
                Dudukan / Tiang Sisip
              </span>
              {fotoTiangDudukan ? (
                <div className="relative w-full aspect-square rounded-xl overflow-hidden border border-slate-300 dark:border-slate-600">
                  <img src={fotoTiangDudukan} alt="Dudukan Tiang Sisip" className="w-full h-full object-cover" />
                  <div className="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 via-black/50 to-transparent p-1.5 flex items-center justify-center gap-1.5">
                    <button
                      type="button"
                      onClick={() => setPreviewPhotoModal(fotoTiangDudukan)}
                      className="h-7 px-2 bg-white text-slate-900 rounded-lg text-[10px] font-bold flex items-center gap-1 shadow active:scale-95 cursor-pointer"
                    >
                      <Eye className="w-3 h-3" /> Lihat
                    </button>
                    <button
                      type="button"
                      onClick={() => setFotoTiangDudukan(null)}
                      className="h-7 px-2 bg-rose-600 text-white rounded-lg text-[10px] font-bold flex items-center gap-1 shadow active:scale-95 cursor-pointer"
                    >
                      <Trash2 className="w-3 h-3" /> Ganti
                    </button>
                  </div>
                </div>
              ) : (
                <label className="w-full aspect-square min-h-[90px] border-2 border-dashed border-slate-300 dark:border-slate-700 rounded-xl flex flex-col items-center justify-center cursor-pointer hover:bg-purple-50 dark:hover:bg-slate-800 transition-colors p-1.5 text-center active:scale-[0.98]">
                  <Camera className="w-5 h-5 text-slate-400 mb-1" />
                  <span className="text-[10px] font-semibold text-purple-700 dark:text-purple-300 leading-tight">
                    {processingPhoto === 'tiang' ? 'Proses...' : '+ Tiang / Dudukan'}
                  </span>
                  <input
                    type="file"
                    accept="image/*"
                    capture="environment"
                    onChange={(e) => handlePhotoUpload(e, 'tiang')}
                    className="hidden"
                  />
                </label>
              )}
            </div>

            {/* Foto 3: Sebelum Pekerjaan */}
            <div className="border border-slate-200 dark:border-slate-700 rounded-2xl p-2.5 flex flex-col items-center justify-center text-center bg-slate-50/60 dark:bg-slate-850">
              <span className="text-[11px] font-bold text-slate-800 dark:text-slate-200 mb-1.5 line-clamp-1">
                Sebelum Pasang (Awal)
              </span>
              {fotoSebelum ? (
                <div className="relative w-full aspect-square rounded-xl overflow-hidden border border-slate-300 dark:border-slate-600">
                  <img src={fotoSebelum} alt="Sebelum Pasang" className="w-full h-full object-cover" />
                  <div className="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 via-black/50 to-transparent p-1.5 flex items-center justify-center gap-1.5">
                    <button
                      type="button"
                      onClick={() => setPreviewPhotoModal(fotoSebelum)}
                      className="h-7 px-2 bg-white text-slate-900 rounded-lg text-[10px] font-bold flex items-center gap-1 shadow active:scale-95 cursor-pointer"
                    >
                      <Eye className="w-3 h-3" /> Lihat
                    </button>
                    <button
                      type="button"
                      onClick={() => setFotoSebelum(null)}
                      className="h-7 px-2 bg-rose-600 text-white rounded-lg text-[10px] font-bold flex items-center gap-1 shadow active:scale-95 cursor-pointer"
                    >
                      <Trash2 className="w-3 h-3" /> Ganti
                    </button>
                  </div>
                </div>
              ) : (
                <label className="w-full aspect-square min-h-[90px] border-2 border-dashed border-slate-300 dark:border-slate-700 rounded-xl flex flex-col items-center justify-center cursor-pointer hover:bg-purple-50 dark:hover:bg-slate-800 transition-colors p-1.5 text-center active:scale-[0.98]">
                  <Camera className="w-5 h-5 text-slate-400 mb-1" />
                  <span className="text-[10px] font-semibold text-purple-700 dark:text-purple-300 leading-tight">
                    {processingPhoto === 'sebelum' ? 'Proses...' : '+ Kondisi Awal'}
                  </span>
                  <input
                    type="file"
                    accept="image/*"
                    capture="environment"
                    onChange={(e) => handlePhotoUpload(e, 'sebelum')}
                    className="hidden"
                  />
                </label>
              )}
            </div>

            {/* Foto 4: Sesudah Pekerjaan */}
            <div className="border border-slate-200 dark:border-slate-700 rounded-2xl p-2.5 flex flex-col items-center justify-center text-center bg-slate-50/60 dark:bg-slate-850">
              <span className="text-[11px] font-bold text-slate-800 dark:text-slate-200 mb-1.5 line-clamp-1">
                Sesudah (Bertegangan)
              </span>
              {fotoSesudah ? (
                <div className="relative w-full aspect-square rounded-xl overflow-hidden border border-slate-300 dark:border-slate-600">
                  <img src={fotoSesudah} alt="Sesudah Pasang" className="w-full h-full object-cover" />
                  <div className="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 via-black/50 to-transparent p-1.5 flex items-center justify-center gap-1.5">
                    <button
                      type="button"
                      onClick={() => setPreviewPhotoModal(fotoSesudah)}
                      className="h-7 px-2 bg-white text-slate-900 rounded-lg text-[10px] font-bold flex items-center gap-1 shadow active:scale-95 cursor-pointer"
                    >
                      <Eye className="w-3 h-3" /> Lihat
                    </button>
                    <button
                      type="button"
                      onClick={() => setFotoSesudah(null)}
                      className="h-7 px-2 bg-rose-600 text-white rounded-lg text-[10px] font-bold flex items-center gap-1 shadow active:scale-95 cursor-pointer"
                    >
                      <Trash2 className="w-3 h-3" /> Ganti
                    </button>
                  </div>
                </div>
              ) : (
                <label className="w-full aspect-square min-h-[90px] border-2 border-dashed border-slate-300 dark:border-slate-700 rounded-xl flex flex-col items-center justify-center cursor-pointer hover:bg-purple-50 dark:hover:bg-slate-800 transition-colors p-1.5 text-center active:scale-[0.98]">
                  <Camera className="w-5 h-5 text-slate-400 mb-1" />
                  <span className="text-[10px] font-semibold text-purple-700 dark:text-purple-300 leading-tight">
                    {processingPhoto === 'sesudah' ? 'Proses...' : '+ Bertegangan'}
                  </span>
                  <input
                    type="file"
                    accept="image/*"
                    capture="environment"
                    onChange={(e) => handlePhotoUpload(e, 'sesudah')}
                    className="hidden"
                  />
                </label>
              )}
            </div>
          </div>
        </div>

        {/* SECTION 4: TANDA TANGAN PENGAWAS PEKERJAAN (NAMA & NIP KOSONG AGAR BISA DIISI MANUAL) */}
        <div className="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
          <div className="flex items-center justify-between">
            <label className="text-xs font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider flex items-center gap-1.5">
              <PenTool className="w-3.5 h-3.5 text-purple-600 dark:text-purple-400" />
              4. PENGESAHAN: PENGAWAS PEKERJAAN LAPANGAN
            </label>
            <span className="text-[10px] text-slate-500">
              Diteruskan ke Supervisor
            </span>
          </div>

          <SignaturePad
            label="Tanda Tangan Pengawas Pekerjaan Lapangan"
            roleDescription={`Pengawas Pekerjaan Pemasangan Trafo Sisip ${user.unit}`}
            initialSignature={sigPengawasUrl}
            onSave={setSigPengawasUrl}
            name={namaPengawas}
            nip={nipPengawas}
            onNameChange={setNamaPengawas}
            onNipChange={setNipPengawas}
          />

          <div className="p-3 bg-purple-50/70 dark:bg-purple-950/30 rounded-xl border border-purple-200 dark:border-purple-800 space-y-1 text-xs">
            <div className="font-bold text-slate-800 dark:text-slate-200">
              Pengesahan Supervisor &amp; Mengetahui Manager ULP:
            </div>
            <p className="text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed">
              Tanda tangan persetujuan TL Teknik dan nama Manager ULP akan diisi pada <strong>Menu Approval (Akun Supervisor)</strong>. Tanda tangan Manager ULP akan dicetak kosong pada PDF Berita Acara untuk penandatanganan fisik.
            </p>
          </div>
        </div>

        {/* SUBMIT BUTTON */}
        <div className="pt-2 space-y-2">
          <button
            type="submit"
            className="w-full h-14 bg-gradient-to-r from-purple-700 to-indigo-800 hover:from-purple-800 hover:to-indigo-900 text-white rounded-2xl font-extrabold text-sm shadow-xl shadow-purple-950/20 active:scale-[0.98] transition-all flex items-center justify-center gap-2.5 cursor-pointer"
          >
            <Send className="w-5 h-5 text-amber-300" />
            <span>Selesai Input Trafo Sisip &amp; Kirim ke Menu Supervisor</span>
          </button>

          <div className="text-center text-[10px] text-slate-400 flex items-center justify-center gap-1.5">
            <Clock className="w-3 h-3 text-slate-400" />
            <span>
              Data otomatis masuk ke Menu Approval Supervisor &amp; Sheet &ldquo;{SISIP_TRAFO_SHEET_NAME}&rdquo; (gid={SISIP_TRAFO_SHEET_GID})
            </span>
          </div>
        </div>
      </form>

      {/* MODAL PREVIEW FOTO */}
      {previewPhotoModal && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="relative max-w-2xl w-full bg-slate-900 rounded-2xl overflow-hidden p-2">
            <img src={previewPhotoModal} alt="Preview Foto" className="w-full max-h-[80vh] object-contain rounded-xl" />
            <button
              type="button"
              onClick={() => setPreviewPhotoModal(null)}
              className="absolute top-4 right-4 bg-black/60 hover:bg-black/90 text-white text-xs px-3 py-1.5 rounded-lg cursor-pointer"
            >
              Tutup
            </button>
          </div>
        </div>
      )}

      {/* POPUP PERINGATAN 4 FOTO WAJIB */}
      <PhotoRequirementModal
        isOpen={isPhotoWarningModalOpen}
        onClose={() => setIsPhotoWarningModalOpen(false)}
        onScrollToPhotos={() => {
          setIsPhotoWarningModalOpen(false);
          photoSectionRef.current?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }}
        formTitle="Pemasangan Trafo Sisip"
        photoItems={[
          {
            key: 'fotoNametagSisip',
            label: '1. Foto Nametag Trafo Sisip',
            isFilled: Boolean(fotoNametagSisip),
            hint: 'Foto spesifikasi nameplate trafo baru sisipan',
          },
          {
            key: 'fotoTiangDudukan',
            label: '2. Foto Dudukan / Tiang Trafo Sisip',
            isFilled: Boolean(fotoTiangDudukan),
            hint: 'Foto konstruksi dudukan/tiang trafo sisip',
          },
          {
            key: 'fotoSebelum',
            label: '3. Foto Sebelum Pemasangan',
            isFilled: Boolean(fotoSebelum),
            hint: 'Dokumentasi kondisi awal sebelum trafo dipasang',
          },
          {
            key: 'fotoSesudah',
            label: '4. Foto Sesudah Pemasangan',
            isFilled: Boolean(fotoSesudah),
            hint: 'Dokumentasi trafo sisip telah terpasang dan bertegangan',
          },
        ]}
      />

      {/* POPUP SUBMIT KE SUPERVISOR */}
      <ManajemenTrafoSubmitPopup
        isOpen={isSubmitPopupOpen}
        stage={popupStage}
        draftRecord={draftTrafoRecord}
        user={user}
        isOnline={isOnline}
        isGoogleConnected={isGoogleConnected}
        progressText={popupProgressText}
        syncResult={popupSyncResult}
        errorMessage={popupErrorMessage}
        onCancel={() => {
          if (popupStage === 'sending') return;
          setIsSubmitPopupOpen(false);
        }}
        onConfirmSendToSupervisor={executeConfirmedSendToSupervisor}
        onFinishAndReset={handleResetForm}
        onGoToSupervisorMenu={onNavigateToApproval}
      />
    </div>
  );
};